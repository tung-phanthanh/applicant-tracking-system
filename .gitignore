# --- Main Ignores ---
.agent/
.agents/
.gemini/
.idea/
.vscode/

# --- File Types (Global Exclusions) ---
*.properties
*.md
*.xml
*.env
*.env.*
*.log
*.txt
*.tmp
*.sql

# --- Folder Exclusions ---
**/target/
**/node_modules/
**/dist/
**/build/

# --- Test Exclusions ---
**/src/test/
**/*.test.tsx
**/*.test.ts
**/*.test.js

# --- Specific path rules ---
# Only allow files in these folders (though global patterns still apply)
!backend/
!frontend/
